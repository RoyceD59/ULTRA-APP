{
  "name": "@workspace/uc-companion",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=$CLERK_PUBLISHABLE_KEY EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_API_DOMAIN=$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:startup-fonts": "node --test scripts/__tests__/startup-fonts.test.mjs && node scripts/check-startup-fonts.cjs",
    "test": "TSX_TSCONFIG_PATH=$(pwd)/tsconfig.test.json node --import ./test-setup.mjs --import tsx/esm --test hooks/__tests__/**/*.test.mts lib/__tests__/**/*.test.mts scripts/__tests__/*.test.mjs components/__tests__/*.test.mts",
    "eas-build-pre-install": "node scripts/validate-preview-build.mjs && node scripts/eas-build-maps-check.mjs",
    "submit:android": "node scripts/submit-android.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@clerk/expo": "^4.2.8",
