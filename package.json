{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@>=0.7 <0.9": "0.8.15",
      "@xmldom/xmldom@>=0.9 <0.10": "0.9.12",
      "brace-expansion@>=1.1.16 <2": "1.1.18",
      "brace-expansion@>=2.1.2 <3": "2.1.4",
      "brace-expansion@>=5.0.7 <6": "5.0.12",
      "browserslist": "4.28.9",
      "decode-uri-component": "0.5.0",
      "esbuild@<=0.24.2": "0.25.8",
      "fast-uri": "4.2.1",
      "ip-address@>=10 <11": "10.7.3",
      "markdown-it@>=14 <15": "14.3.2",
      "js-yaml@>=3 <4": "3.15.2",
      "js-yaml@>=4 <5": "4.3.2",
      "nanoid@<3.3.18": "3.3.18",
      "postcss": "8.5.26",
      "fast-xml-parser": "5.10.1",
      "qs": "6.16.0",
      "tar": "7.5.22",
      "undici@<6.28.0": "6.28.1",
      "undici@>=8 <9": "8.11.2",
      "uuid": "11.1.1",
      "shell-quote": "1.11.0",
      "music-metadata": "11.16.0",
      "fast-copy": "4.1.0",
      "postcss-selector-parser": "7.1.6",
      "http-cache-semantics": "4.3.0"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch",
      "http-cache-semantics@4.3.0": "patches/http-cache-semantics@4.2.0.patch",
      "node-forge@1.4.0": "patches/node-forge@1.4.0.patch"
    }
  },
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "pnpm --filter @workspace/api-zod run check:phone && tsc --build",
    "test:dependency-security": "node --test scripts/tests/dependency-security.test.mjs",
    "test:customers-browser": "PROJECTHUB_BROWSER_TEST=1 TEST_GLOB=src/tests/browser/customer-export.test.ts pnpm --filter @workspace/api-server test",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  }
}
