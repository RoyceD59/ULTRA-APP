# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Un-ignore test doubles in hooks/node_modules/.
# Node.js resolves these first for files in hooks/ (nearest-node_modules rule),
# giving the test runner and the module-under-test the same stub instance.
# Metro never sees them: hooks/node_modules is in metro.config.js blockList.
!hooks/node_modules/
!hooks/node_modules/**

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env
