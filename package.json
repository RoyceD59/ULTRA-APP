{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@>=0.7 <0.9": "0.8.15",
      "@xmldom/xmldom@>=0.9 <0.10": "0.9.12",
      "brace-expansion@>=1.1.16 <2": "1.1.18",
      "brace-expansion@>=2.1.2 <3": "2.1.4",
      "brace-expansion@>=5.0.7": "5.0.9",
      "browserslist": "4.28.9",
      "decode-uri-component": "0.5.0",
      "esbuild@<=0.24.2": "0.25.8",
      "fast-uri": "4.1.4",
      "js-yaml@>=3 <4": "3.15.1",
      "js-yaml@>=4 <5": "4.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss": "8.5.26",
      "fast-xml-parser": "5.10.1",
      "qs": "6.16.0",
      "tar": "7.5.22",
      "undici@<6.28.0": "6.28.1",
      "uuid": "11.1.1"
    },
    "patchedDependencies": {
      "image-size@1.2.1": "patches/image-size@1.2.1.patch"
    }
  },
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
