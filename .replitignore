# The format of this file is identical to `.dockerignore`.
/generated-artifacts/public-impact-monitor/
/generated-artifacts/guest-payment-fixture/
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Local tooling caches are not runtime inputs.
.cache/

# Do not exclude whole frozen stages or recursively match node_modules here:
# stages contain runtime servers/worker outputs, and public assets can use
# node_modules in their URL paths. The deployment post-build hook removes only
# installed staging dependencies, including copies generated during compilation.
